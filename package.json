{
  "name": "fileblocks",
  "displayName": "Fileblocks",
  "description": "See and edit JSON, YAML, TOML, XML and HTML as an editable node graph, with JSON Schema, XSD and DTD validation.",
  "version": "0.1.0",
  "publisher": "alessandrovoliveira",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1b1c26",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AlessandroVOliveira/Fileblocks.git"
  },
  "bugs": {
    "url": "https://github.com/AlessandroVOliveira/Fileblocks/issues"
  },
  "homepage": "https://github.com/AlessandroVOliveira/Fileblocks#readme",
  "keywords": [
    "json",
    "yaml",
    "toml",
    "xml",
    "html",
    "graph",
    "visualizer",
    "editor",
    "json schema",
    "xsd",
    "dtd",
    "json crack"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "fileblocks.blockEditor",
        "displayName": "Fileblocks",
        "priority": "option",
        "selector": [
          {
            "filenamePattern": "*.json"
          },
          {
            "filenamePattern": "*.jsonc"
          },
          {
            "filenamePattern": "*.yaml"
          },
          {
            "filenamePattern": "*.yml"
          },
          {
            "filenamePattern": "*.toml"
          },
          {
            "filenamePattern": "*.xml"
          },
          {
            "filenamePattern": "*.html"
          },
          {
            "filenamePattern": "*.htm"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "fileblocks.openBlockEditor",
        "title": "Open in Block Editor",
        "category": "Fileblocks",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "fileblocks.selectSchema",
        "title": "Select Schema…",
        "category": "Fileblocks",
        "icon": "$(json)"
      },
      {
        "command": "fileblocks.exportImage",
        "title": "Export Graph as Image…",
        "category": "Fileblocks",
        "icon": "$(export)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "fileblocks.openBlockEditor",
          "when": "resourceExtname =~ /^\\.(json|jsonc|ya?ml|xml|html?|toml)$/ && activeCustomEditorId != 'fileblocks.blockEditor'",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "fileblocks.openBlockEditor",
          "when": "resourceExtname =~ /^\\.(json|jsonc|ya?ml|xml|html?|toml)$/",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "fileblocks.selectSchema",
          "when": "activeCustomEditorId == 'fileblocks.blockEditor'"
        },
        {
          "command": "fileblocks.exportImage",
          "when": "activeCustomEditorId == 'fileblocks.blockEditor'"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package --no-dependencies",
    "test": "esbuild \"test/*.test.ts\" --bundle --platform=node --main-fields=module,main --outdir=out/test --log-level=warning && node --test \"out/test/*.test.js\"",
    "publish": "vsce publish --no-dependencies"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.8",
    "@vscode/codicons": "^0.0.36",
    "@xyflow/react": "^12.12.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "domhandler": "^5.0.3",
    "html-to-image": "^1.11.13",
    "htmlparser2": "^10.1.0",
    "jsonc-parser": "^3.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "toml-eslint-parser": "^0.10.1",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
