{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "App config",
  "type": "object",
  "required": ["name", "servers"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "description": "Application name, shown in the UI." },
    "mode": { "enum": ["development", "staging", "production"], "default": "development", "description": "Deployment environment." },
    "debug": { "type": "boolean", "default": false },
    "owner": {
      "type": "object",
      "required": ["email"],
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email", "description": "Who gets alerts." }
      }
    },
    "servers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/server" }
    }
  },
  "definitions": {
    "server": {
      "type": "object",
      "required": ["host", "port"],
      "properties": {
        "host": { "type": "string", "description": "Host name or IP address." },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "protocol": { "enum": ["http", "https"], "default": "https" }
      }
    }
  }
}
